// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("seeker") // seeker | employer | admin
  title         String?
  company       String?
  avatarColor   String   @default("oklch(0.55 0.22 285)")
  initials      String?
  location      String?
  status        String   @default("active") // active | suspended | pending
  about         String?
  profilePhoto  String?  // base64-encoded image data URL
  resetToken    String?  // password reset token
  resetTokenExpiry DateTime?  // token expiry time

  // Relations
  sessions     Session[]
  skills       Skill[]
  experiences  Experience[]
  educations   Education[]
  applications Application[]
  jobsPosted   Job[]      @relation("JobEmployer")
  notifications Notification[]
  auditLogs    AuditLog[]
  news         News[]     @relation("NewsAuthor")
  resumes      Resume[]

  // 2FA
  twoFactorSecretHash String?
  twoFactorEnabled    Boolean @default(false)
  twoFactorBackupHash String? // JSON array of hashed backup codes
  emailOtpCode        String?  // email-based OTP code
  emailOtpExpiry      DateTime? // OTP expiry time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// SEEKER PROFILE
// ============================================================

model Skill {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String   @default("General")
  proficiency  String   @default("intermediate") // beginner | intermediate | advanced | expert
  verified     String   @default("unverified")    // verified | pending | unverified
  yearsOfExperience Int?
  source       String   @default("manual") // manual | ai_extraction | assessment
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

model Experience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  title       String
  startDate   String
  endDate     String
  description String?
  current     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Education {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String
  startDate   String
  endDate     String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ============================================================
// JOBS & APPLICATIONS
// ============================================================

model Job {
  id          String   @id @default(cuid())
  employerId  String
  employer    User     @relation("JobEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  title       String
  company     String
  companyLogo String?
  location    String
  remote      String   @default("onsite") // onsite | hybrid | remote
  type        String   @default("full-time")
  category    String
  salaryMin   Int
  salaryMax   Int
  currency    String   @default("USD")
  salaryPeriod String  @default("month")
  description String
  status      String   @default("draft") // draft | published | paused | closed | expired
  expiresAt   DateTime? // when the job posting expires; null = no expiry
  postedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Standardized job-posting fields
  responsibilities  String  @default("[]") // JSON array of strings
  requirements      String  @default("[]") // JSON array of strings
  niceToHave        String  @default("[]") // JSON array of strings (preferred but not mandatory)
  qualifications    String  @default("[]") // JSON array of strings (e.g. "Bachelor's degree in Computer Science")
  // Eligibility criteria for auto-screening
  minEducationLevel String? // high-school | diploma | bachelor | master | phd | any
  fieldOfStudy      String? // e.g. "Computer Science" — if set, applicant's education field must match (mandatory)
  fieldOfStudyMandatory Boolean @default(false) // if true, applicants with non-matching field are blocked
  minExperienceYears Int    @default(0) // minimum years of experience required
  requiredSkills    String  @default("[]") // JSON array of { name, mandatory } — mandatory skills are checked against applicant's CV
  // Attachments (JSON arrays of { fileName, fileData, mimeType })
  attachments       String  @default("[]") // DOC/DOCX/PDF documents attached to the job post
  images            String  @default("[]") // photos/images attached to the job post

  applications Application[]
  examSchedules ExamSchedule[]
  interviewSchedules InterviewSchedule[]

  @@index([employerId])
  @@index([status])
  @@index([expiresAt])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("applied")
  // 7-step recruitment pipeline status:
  //   applied → reviewing → review_passed → exam_notified → exam_completed →
  //   exam_passed → interview_notified → interview_completed → interview_passed →
  //   selected → hired
  //   (rejected at any stage)
  matchScore  Int?
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Step 1: Application — professional application letter
  coverLetter String?

  // Step 2: Application Review
  reviewedAt      DateTime?
  reviewPassed    Boolean?
  reviewNotes     String?

  // Step 3 & 4: Written Examination
  examNotifiedAt  DateTime?
  examCompletedAt DateTime?
  examScore       Int?      // 0-100
  examPassed      Boolean?
  examNotes       String?

  // Step 5: Interview (oral + practical)
  interviewNotifiedAt   DateTime?
  interviewCompletedAt  DateTime?
  oralScore             Int?      // 0-100
  practicalScore        Int?      // 0-100
  interviewOverallScore Int?      // 0-100 (computed)
  interviewPassed       Boolean?
  interviewNotes        String?

  // Step 6: Final Selection
  selectedAt      DateTime?
  selectionNotes  String?

  // Step 7: Final Call & Job Assignment
  hiredAt         DateTime?
  jobAssignment   String?   // responsibilities, work location, starting date, etc.
  finalCallNotes  String?

  // Rejection (can happen at any stage)
  rejectedAt      DateTime?
  rejectionStage  String?   // which step the candidate was rejected at
  rejectionReason String?

  @@index([jobId])
  @@index([userId])
  @@index([status])
}

// ============================================================
// EXAM SCHEDULE — per-job written exam configuration (Step 3 & 4)
// ============================================================
model ExamSchedule {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scheduledAt DateTime              // when the exam takes place
  duration    Int      @default(60) // duration in minutes
  location    String   @default("Online")
  format      String   @default("written") // written | online | practical
  instructions String?              // what to prepare, what to bring, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
}

// ============================================================
// INTERVIEW SCHEDULE — per-job interview configuration (Step 5)
// ============================================================
model InterviewSchedule {
  id              String   @id @default(cuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime              // when the interview takes place
  duration        Int      @default(60) // duration in minutes
  location        String   @default("Online")
  format          String   @default("both") // oral | practical | both
  instructions    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([jobId])
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // application | message | interview | system | match
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String
  type      String   @default("admin") // auth | job | application | ai | admin | message
  ip        String?
  status    String   @default("success") // success | warning | error
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// SITE IMAGES — managed content images (home page group photos, etc.)
// ============================================================
model SiteImage {
  id          String   @id @default(cuid())
  key         String   @unique          // e.g. "home-group-1", "home-hero"
  src         String                    // URL path ("/groups/group1.jpg") or data URL
  alt         String                    // accessibility alt text
  caption     String?                   // short caption shown on the image
  description String?                   // longer description shown on the image
  accent      String   @default("from-violet-500 to-blue-500") // tailwind gradient classes
  category    String   @default("home") // home | about | landing | etc.
  sortOrder   Int      @default(0)      // lower = first
  isActive    Boolean  @default(true)   // soft-delete / hide toggle
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ============================================================
// NEWS — platform announcements & updates published by admins
// ============================================================
model News {
  id           String   @id @default(cuid())
  title        String
  content      String
  excerpt      String?
  category     String   @default("Update") // Update | Announcement | Event | Release | Maintenance
  imageUrl     String?  // optional cover image (URL path or base64 data URL)
  status       String   @default("published") // published | draft
  pinned       Boolean  @default(false) // pinned items appear first
  authorId     String?
  author       User?    @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

// ============================================================
// RESUME / CV — uploaded CVs with AI analysis results
// ============================================================
model Resume {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String                        // original uploaded filename
  rawText     String                        // extracted text from the CV
  fileSize    Int                           // file size in bytes
  mimeType    String   @default("application/pdf")
  // AI analysis result stored as JSON string:
  // { skills, strengths, weaknesses, experience, skillGaps, summary, yearsOfExperience, ... }
  analysis    String   @default("{}")
  analyzedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

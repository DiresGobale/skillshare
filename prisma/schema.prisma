// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("seeker") // seeker | employer | admin
  title         String?
  company       String?
  avatarColor   String   @default("oklch(0.55 0.22 285)")
  initials      String?
  location      String?
  status        String   @default("active") // active | suspended | pending
  about         String?
  profilePhoto  String?  // base64-encoded image data URL
  resetToken    String?  // password reset token
  resetTokenExpiry DateTime?  // token expiry time

  // Relations
  sessions     Session[]
  skills       Skill[]
  experiences  Experience[]
  educations   Education[]
  applications Application[]
  jobsPosted   Job[]      @relation("JobEmployer")
  notifications Notification[]
  auditLogs    AuditLog[]

  // 2FA
  twoFactorSecretHash String?
  twoFactorEnabled    Boolean @default(false)
  twoFactorBackupHash String? // JSON array of hashed backup codes
  emailOtpCode        String?  // email-based OTP code
  emailOtpExpiry      DateTime? // OTP expiry time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// SEEKER PROFILE
// ============================================================

model Skill {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String   @default("General")
  proficiency  String   @default("intermediate") // beginner | intermediate | advanced | expert
  verified     String   @default("unverified")    // verified | pending | unverified
  yearsOfExperience Int?
  source       String   @default("manual") // manual | ai_extraction | assessment
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

model Experience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  title       String
  startDate   String
  endDate     String
  description String?
  current     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Education {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String
  startDate   String
  endDate     String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ============================================================
// JOBS & APPLICATIONS
// ============================================================

model Job {
  id          String   @id @default(cuid())
  employerId  String
  employer    User     @relation("JobEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  title       String
  company     String
  companyLogo String?
  location    String
  remote      String   @default("onsite") // onsite | hybrid | remote
  type        String   @default("full-time")
  category    String
  salaryMin   Int
  salaryMax   Int
  currency    String   @default("USD")
  salaryPeriod String  @default("month")
  description String
  status      String   @default("draft") // draft | published | paused | closed | expired
  expiresAt   DateTime? // when the job posting expires; null = no expiry
  postedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]

  @@index([employerId])
  @@index([status])
  @@index([expiresAt])
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("submitted") // submitted | screening | shortlisted | interview | offer | rejected | withdrawn
  matchScore Int?
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([userId])
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // application | message | interview | system | match
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String
  type      String   @default("admin") // auth | job | application | ai | admin | message
  ip        String?
  status    String   @default("success") // success | warning | error
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// SITE IMAGES — managed content images (home page group photos, etc.)
// ============================================================
model SiteImage {
  id          String   @id @default(cuid())
  key         String   @unique          // e.g. "home-group-1", "home-hero"
  src         String                    // URL path ("/groups/group1.jpg") or data URL
  alt         String                    // accessibility alt text
  caption     String?                   // short caption shown on the image
  description String?                   // longer description shown on the image
  accent      String   @default("from-violet-500 to-blue-500") // tailwind gradient classes
  category    String   @default("home") // home | about | landing | etc.
  sortOrder   Int      @default(0)      // lower = first
  isActive    Boolean  @default(true)   // soft-delete / hide toggle
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}
